{
  "name": "im-agent",
  "version": "0.2.7",
  "type": "module",
  "description": "把飞书（以及以后的 Telegram 等）和 Web 页面桥接到本机 Claude Code / Codex：聊天驱动、卡片审批、会话与模型切换",
  "keywords": [
    "feishu",
    "lark",
    "claude-code",
    "codex",
    "bridge",
    "agent",
    "飞书"
  ],
  "license": "MIT",
  "author": "qijieinnet",
  "homepage": "https://github.com/qijieinnet/im-agent#readme",
  "bugs": {
    "url": "https://github.com/qijieinnet/im-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qijieinnet/im-agent.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "im-agent": "bin/cli.js",
    "ima": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js start",
    "dev": "IM_AGENT_HOME=./.dev tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "dompurify": "^3.2.0",
    "marked": "^16.0.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
