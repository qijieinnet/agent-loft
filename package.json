{
  "name": "agent-loft",
  "version": "0.2.63",
  "type": "module",
  "description": "多个 agent 的工作台：把本机 Claude Code / Codex 放到一处统一管理，用飞书和 Web 页面随时驱动——会话、审批、模型切换都共用",
  "keywords": [
    "feishu",
    "lark",
    "claude-code",
    "codex",
    "bridge",
    "agent",
    "飞书"
  ],
  "license": "MIT",
  "author": "qijieinnet",
  "homepage": "https://github.com/qijieinnet/agent-loft#readme",
  "bugs": {
    "url": "https://github.com/qijieinnet/agent-loft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qijieinnet/agent-loft.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agent-loft": "bin/cli.js",
    "aloft": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js start",
    "dev": "AGENT_LOFT_HOME=./.dev tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.0",
    "echarts": "^6.1.0",
    "marked": "^16.0.0",
    "mermaid": "^12.2.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
