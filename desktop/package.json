{
  "name": "agent-loft-desktop",
  "productName": "Agent Loft",
  "desktopName": "agent-loft-desktop.desktop",
  "version": "0.1.15",
  "private": true,
  "description": "agent-loft 的桌面端（macOS / Windows / Linux）：同时连多台 agent-loft 服务器，菜单栏 / 托盘显示额度和待处理，检测并升级服务端",
  "author": "qijieinnet",
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "smoke": "AGENT_LOFT_DESKTOP_SMOKE=1 electron .",
    "icons": "electron scripts/icons.js",
    "dist": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.qijieinnet.agentloft",
    "productName": "Agent Loft",
    "artifactName": "Agent-Loft-${version}-${arch}.${ext}",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Agent Loft ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Agent-Loft-Setup-${version}-${arch}.${ext}",
      "shortcutName": "Agent Loft",
      "uninstallDisplayName": "Agent Loft"
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "agent-loft-desktop",
      "category": "Development",
      "synopsis": "同时连多台 agent-loft 服务器的桌面端",
      "maintainer": "qijieinnet <qijieinnet@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true,
      "description": "同时连多台 agent-loft 服务器，托盘里看额度和待处理"
    },
    "appImage": {
      "artifactName": "Agent-Loft-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "agent-loft-desktop_${version}_${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/qijieinnet/agent-loft"
}
